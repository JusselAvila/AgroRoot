# Server
PORT=3000
DATABASE_PATH=./data/agroroot.db

# --- WDK / ERC-4337 (Sepolia) — Persona A block 2 ---
# Never commit real secrets. Copy this file to .env and fill locally.

# BIP-39 seed that owns the smart account (keep private)
SEED_PHRASE=

# Network
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Bundler + paymaster (Candide public Sepolia defaults — swap for Pimlico if you prefer)
# Candide:
BUNDLER_URL=https://api.candide.dev/public/v3/11155111
PAYMASTER_URL=https://api.candide.dev/public/v3/11155111
PAYMASTER_ADDRESS=0x8b1f6cb5d062aa2ce8d581942bbb960420d875ba
# Pimlico alternative:
# BUNDLER_URL=https://public.pimlico.io/v2/11155111/rpc
# PAYMASTER_URL=https://public.pimlico.io/v2/11155111/rpc
# PAYMASTER_ADDRESS=0x777777777777AeC03fd955926DbF81597e66834C

# USD₮ test token on Sepolia (same address for transfer + gas payment)
PAYMASTER_TOKEN_ADDRESS=0xd077a400968890eacc75cdc901f0356c943e4fdb
USDT_TOKEN_ADDRESS=0xd077a400968890eacc75cdc901f0356c943e4fdb

# Safe modules (WDK beta.15+ requires 0.3.0)
SAFE_MODULES_VERSION=0.3.0

# Optional checklist field from the hackathon brief (not required by WDK config)
DELEGATION_ADDRESS=

# Transfer under test
TRANSFER_TO=
TRANSFER_AMOUNT=1000000
# Sepolia paymaster quotes are often ~2–3 USD₮; 0.1 was too low and aborts the send.
TRANSFER_MAX_FEE=5000000
TRANSACTION_MAX_FEE=5000000
ACCOUNT_INDEX=0
# ACCOUNT_INDEX is the treasury (pays farmers). Farmer smart accounts use farmer.id as index.

# Set true to only quote (no UserOperation). Block 2 exit needs a real hash → leave false.
WDK_DRY_RUN=false

ON_CHAIN_IDENTIFIER=AgroRoot
